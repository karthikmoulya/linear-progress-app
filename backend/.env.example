# Linear → Settings → Security & access → Personal API keys (used when AUTH_DISABLED=true)
LINEAR_API_KEY=lin_api_xxx
# The project's ID: Linear → project → ⋯ → Copy ID
LINEAR_PROJECT_ID=

# Sign in with Linear (Linear → Settings → API → OAuth applications)
AUTH_DISABLED=true
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
# Dev goes through the Vite proxy; on Render use https://<your-app>.onrender.com/auth/callback
OAUTH_REDIRECT_URI=http://localhost:5173/auth/callback
# Any long random string: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=
# Comma-separated Linear user IDs allowed in
ALLOWED_LINEAR_USER_IDS=
